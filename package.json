              </h2>
              <p className="text-slate-300 text-sm font-light">
                Calculate your direct overhead savings compared to local in-house hiring.
              </p>
            </div>

            <div className="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center bg-[#060E18] border border-[#E5D5B8]/25 rounded-3xl p-8 lg:p-12">
              
              <div className="lg:col-span-7 space-y-6">
                <div className="space-y-4">
                  <div className="flex items-center justify-between p-4 bg-[#0E1A2B] border border-[#E5D5B8]/15 rounded-xl">
                    <div>
                      <div className="text-xs font-semibold text-slate-200">Admin Pod ($500/mo)</div>
                      <div className="text-[11px] text-slate-400">Replaces $3,800/mo domestic admin salary</div>
                    </div>
                    <input 
                      type="checkbox" 
                      checked={adminTier} 
                      onChange={(e) => setAdminTier(e.target.checked)}
                      className="w-5 h-5 accent-[#E5D5B8] cursor-pointer"
                    />
                  </div>

                  <div className="flex items-center justify-between p-4 bg-[#0E1A2B] border border-[#E5D5B8]/15 rounded-xl">
                    <div>
                      <div className="text-xs font-semibold text-slate-200">Paralegal Pod ($1,000/mo)</div>
                      <div className="text-[11px] text-slate-400">Replaces $5,800/mo senior paralegal salary</div>
                    </div>
                    <input 
                      type="checkbox" 
                      checked={paralegalTier} 
                      onChange={(e) => setParalegalTier(e.target.checked)}
                      className="w-5 h-5 accent-[#E5D5B8] cursor-pointer"
                    />
                  </div>
                </div>

                <div className="space-y-2 pt-2">
                  <div className="flex justify-between text-xs">
                    <span className="text-slate-300 font-semibold uppercase tracking-wider">Audio Minutes / Month</span>
                    <span className="text-[#E5D5B8] font-bold">{transcriptionMins} mins ($1.50/min)</span>
                  </div>
                  <input 
                    type="range" 
                    min="0" 
                    max="1000" 
                    step="25" 
                    value={transcriptionMins} 
                    onChange={(e) => setTranscriptionMins(Number(e.target.value))}
                    className="w-full accent-[#E5D5B8] cursor-pointer bg-slate-800 h-2 rounded-lg"
                  />
                </div>
              </div>

              {/* CALCULATOR RESULTS */}
              <div className="lg:col-span-5 bg-[#0E1A2B] border border-[#E5D5B8]/30 rounded-2xl p-8 text-center space-y-6">
                <div className="text-xs uppercase tracking-widest text-slate-400 font-semibold">
                  Estimated Net Overhead Savings
                </div>

                <div>
                  <div className="font-serif text-4xl lg:text-5xl font-bold text-[#E5D5B8]">
                    {currency}{annualSavings.toLocaleString()}
                  </div>
                  <div className="text-[11px] text-emerald-400 mt-2 font-medium">
                    Annual capital retained by your firm
                  </div>
                </div>

                <div className="text-xs text-slate-400 border-t border-[#E5D5B8]/15 pt-4 flex justify-between">
                  <span>In-House Benchmark:</span>
                  <span className="line-through">{currency}{inHouseBenchmark.toLocaleString()}/yr</span>
                </div>

                <button 
                  onClick={() => handleOpenModal('Calculator Proposal')}
                  className="w-full bg-gradient-to-r from-[#E5D5B8] to-[#C8B195] text-[#060E18] font-bold py-3.5 rounded-xl text-xs uppercase tracking-wider shadow-lg hover:opacity-90 transition-all"
                >
                  Lock In Savings Proposal
                </button>
              </div>

            </div>
          </div>
        </section>

        {/* FOOTER */}
        <footer className="bg-[#03070D] border-t border-[#E5D5B8]/15 py-12 px-6 lg:px-16 text-slate-400 text-xs">
          <div className="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
            <div className="flex items-center gap-3">
              <span className="font-serif text-lg tracking-[0.2em] text-[#E5D5B8] font-bold">KYROZ</span>
              <span className="text-slate-600">|</span>
              <span className="text-slate-400 font-light">Knowing what to do and when.</span>
            </div>
            <div>
              © 2026 KYROZ Managed Legal Operations. Registered Domain: ky-roz.com
            </div>
          </div>
        </footer>

      </div>

      {/* AUDIT MODAL */}
      {isModalOpen && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4">
          <div className="bg-[#0E1A2B] border border-[#E5D5B8]/40 rounded-3xl p-8 max-w-lg w-full space-y-6 relative shadow-2xl">
            <button 
              onClick={() => setIsModalOpen(false)}
              className="absolute top-5 right-5 text-slate-400 hover:text-[#E5D5B8] text-sm font-bold"
            >
              ✕
            </button>

            {!formSubmitted ? (
              <>
                <div>
                  <h3 className="font-serif text-2xl font-bold text-[#E5D5B8]">Request Operational Audit</h3>
                  <p className="text-xs text-slate-300 mt-1">
                    Selected Tier: <span className="text-[#E5D5B8] font-semibold">{modalTier}</span>
                  </p>
                </div>

                <form onSubmit={(e) => { e.preventDefault(); setFormSubmitted(true); }} className="space-y-4 text-xs">
                  <div>
                    <label className="block text-slate-300 font-semibold mb-1">Full Name</label>
                    <input required type="text" placeholder="Managing Partner Name" className="w-full bg-[#060E18] border border-[#E5D5B8]/20 rounded-xl p-3 text-slate-200 focus:border-[#E5D5B8] outline-none" />
                  </div>
                  <div>
                    <label className="block text-slate-300 font-semibold mb-1">Work Email</label>
                    <input required type="email" placeholder="partner@lawfirm.com" className="w-full bg-[#060E18] border border-[#E5D5B8]/20 rounded-xl p-3 text-slate-200 focus:border-[#E5D5B8] outline-none" />
                  </div>
                  <div>
                    <label className="block text-slate-300 font-semibold mb-1">Law Firm Name & Software Stack</label>
                    <input required type="text" placeholder="e.g., Apex Legal (LEAP / Clio)" className="w-full bg-[#060E18] border border-[#E5D5B8]/20 rounded-xl p-3 text-slate-200 focus:border-[#E5D5B8] outline-none" />
                  </div>

                  <button type="submit" className="w-full bg-gradient-to-r from-[#E5D5B8] to-[#C8B195] text-[#060E18] font-bold py-3.5 rounded-xl shadow-lg uppercase tracking-wider text-xs hover:opacity-90 transition-all mt-2">
                    Submit Audit & Pilot Request
                  </button>
                </form>
              </>
            ) : (
              <div className="text-center py-8 space-y-4">
                <CheckCircle2 className="w-12 h-12 text-[#E5D5B8] mx-auto" />
                <h3 className="font-serif text-2xl font-bold text-[#E5D5B8]">Audit Request Received</h3>
                <p className="text-xs text-slate-300 max-w-xs mx-auto">
                  Our operations team will review your software stack and contact you within 24 hours to schedule your 14-day proof-of-work trial.
                </p>
                <button onClick={() => { setIsModalOpen(false); setFormSubmitted(false); }} className="bg-[#060E18] border border-[#E5D5B8]/30 text-[#E5D5B8] px-6 py-2 rounded-full text-xs font-semibold">
                  Close Window
                </button>
              </div>
            )}
          </div>
        </div>
      )}

    </div>
  );
}
